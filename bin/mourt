// Plain JS on purpose: this is the published entrypoint, so it must not need
// a build step to be executable. It loads the *compiled* Cli from dist/.
const Cli = require('../dist/lib/cli');
const process = require('process');
const argv = require('minimist')(process.argv.slice(2), Cli.opts);

const cli = new Cli();
cli.run(argv)
    .then(() => { },
        (err) => {
            console.error(err);
            process.exitCode = 1;
        });
