{
  "name": "@codehivetx/mourt",
  "version": "1.2.2-0",
  "description": "Extensible Diary/Journal Platform",
  "engines": {
    "node": ">=22.3"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "mourt": "bin/mourt"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./lib/cli": {
      "types": "./dist/lib/cli.d.ts",
      "default": "./dist/lib/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-reporter=spec \"dist-test/test/*.test.js\"",
    "build": "tsc",
    "prepublishOnly": "tsc"
  },
  "keywords": [],
  "author": "Steven R. Loomis <srl295@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/codehivetx/mourt.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^4.1.0",
    "configstore": "^5.0.1",
    "minimist": "^1.2.5"
  },
  "devDependencies": {
    "@tsconfig/node16": "^1.0.2",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
